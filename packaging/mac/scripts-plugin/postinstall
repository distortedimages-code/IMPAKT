#!/bin/bash
# IMPAKT's installer (VST3): an older copy built into the user's own plug-in folder (build_mac.command puts them
# there) would shadow the one just installed: it goes.
USER_NOW=$(stat -f%Su /dev/console 2>/dev/null || true)
if [ -n "$USER_NOW" ] && [ "$USER_NOW" != "root" ]; then
    HOME_NOW=$(dscl . -read "/Users/$USER_NOW" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    [ -n "$HOME_NOW" ] && rm -rf "$HOME_NOW/Library/Audio/Plug-Ins/VST3/IMPAKT.vst3"
fi
exit 0
